---
import type { Language } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  currentPage: number;
  totalPages: number;
  prevUrl?: string;
  nextUrl?: string;
  lang?: Language;
  id?: string;
  ariaLabel: string;
}

const {
  currentPage,
  totalPages,
  prevUrl,
  nextUrl,
  lang = 'en',
  id,
  ariaLabel,
} = Astro.props;
const t = useTranslations(lang);
const status = t('pager.status')
  .replace('{current}', String(currentPage))
  .replace('{total}', String(totalPages));

const controlClass =
  'sketch-control inline-flex min-w-20 items-center justify-center px-3 py-2 font-mono text-[0.7rem] tracking-wider text-muted';
---

<nav
  id={id}
  aria-label={ariaLabel}
  class="mt-12 flex items-center justify-between gap-3 border-t border-line/70 pt-7"
>
  {prevUrl ? (
    <a href={prevUrl} rel="prev" class={`${controlClass} hover:border-line-strong hover:text-ink`}>
      <span aria-hidden="true">←</span>
      <span class="ml-2">{t('pager.prev')}</span>
    </a>
  ) : (
    <span aria-disabled="true" class={`${controlClass} cursor-not-allowed opacity-45`}>
      <span aria-hidden="true">←</span>
      <span class="ml-2">{t('pager.prev')}</span>
    </span>
  )}

  <span class="text-center font-mono text-[0.7rem] tracking-wider text-faint">
    {status}
  </span>

  {nextUrl ? (
    <a href={nextUrl} rel="next" class={`${controlClass} hover:border-line-strong hover:text-ink`}>
      <span class="mr-2">{t('pager.next')}</span>
      <span aria-hidden="true">→</span>
    </a>
  ) : (
    <span aria-disabled="true" class={`${controlClass} cursor-not-allowed opacity-45`}>
      <span class="mr-2">{t('pager.next')}</span>
      <span aria-hidden="true">→</span>
    </span>
  )}
</nav>
