{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      // The shared figure library. Articles live at varying depths under
      // src/content/blog/, so the import must not depend on where it is written.
      "@figures/*": ["src/components/figures/*"]
    }
  }
}
