---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import PostFilter from '../../../components/react/PostFilter';
import { TAGS } from '../../../consts';
import { getPosts, leadPostId } from '../../../lib/posts';
import { useTranslations } from '../../../i18n/utils';
import type { Language } from '../../../i18n/ui';

const lang: Language = 'zh';
const t = useTranslations(lang);

const posts = await getPosts(lang);
const lead = leadPostId(posts);

// Only offer tags that actually have posts, in canonical order.
const used = new Set(posts.map((post) => post.data.tag));
const tags = TAGS.filter((tag) => used.has(tag));

const filterLabels = {
  searchPlaceholder: t('blog.searchPlaceholder'),
  filterAll: t('blog.filterAll'),
  showing: t('blog.showing'),
  postSingular: t('blog.postSingular'),
  postPlural: t('blog.postPlural'),
  emptyText: t('blog.empty'),
};
---

<BaseLayout
  lang={lang}
  title={t('blog.title')}
  description={t('site.description')}
>
  <div class="shell py-16 md:py-24">
    <header class="reveal max-w-[48ch]">
      <p class="label flex items-center gap-3">
        <span class="inline-block h-px w-6 bg-accent"></span>
        {t('nav.writing')}
      </p>
      <h1 class="mt-4 text-[clamp(2.5rem,6vw,4.25rem)] leading-[1.02] font-display text-ink">{t('blog.heading')}</h1>
      <p class="mt-6 text-lg leading-relaxed text-muted">
        {posts.length} {t('blog.description')}
      </p>
    </header>

    <div class="reveal mt-12" style="--reveal-delay:80ms">
      <PostFilter client:load tags={tags} targetId="post-grid" emptyId="post-empty" labels={filterLabels} />
    </div>

    <div id="post-grid" class="mt-10 grid gap-6 sm:grid-cols-2">
      {posts.map((post, i) => <PostCard post={post} feature={post.id === lead} delay={i * 60} lang={lang} />)}
    </div>

    <div id="post-empty" hidden class="py-24 text-center">
      <p class="font-mono text-sm text-faint">{t('blog.empty')}</p>
    </div>
  </div>
</BaseLayout>
