---
/**
 * The header is a wordmark and one word, "Menu". Everything a visitor might
 * want — writing, briefs, GitHub, RSS, the language — waits behind that word
 * so the pages, and above all the landing engraving, are not crowded by chrome.
 */
import { getLangFromUrl, getLocalizedPath, listLanguages, useTranslations } from '../i18n/utils';
import { LANGUAGES, type Language } from '../i18n/ui';
import { SITE } from '../consts';

interface Props {
  lang?: Language;
  /** On the landing page the header floats over the engraving. */
  overlay?: boolean;
}

const path = Astro.url.pathname;
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const overlay = Astro.props.overlay ?? false;
const t = useTranslations(lang);

const homeHref = getLocalizedPath('/', lang);
const links = [
  { href: getLocalizedPath('/blog/', lang), label: t('nav.writing'), current: path.startsWith(getLocalizedPath('/blog/', lang)) },
  { href: getLocalizedPath('/brief/', lang), label: t('nav.briefs'), current: path.startsWith(getLocalizedPath('/brief/', lang)) },
];
const external = [
  { href: SITE.github, label: t('nav.github') },
  { href: '/rss.xml', label: t('footer.rss') },
];
const languages = listLanguages().map((code) => ({
  code,
  label: LANGUAGES[code],
  href: getLocalizedPath(path, code),
  current: code === lang,
}));
---

<header id="site-header" class="site-header" data-overlay={overlay ? 'true' : 'false'} data-scrolled="false" data-open="false">
  <div class="shell flex h-14 items-center justify-between">
    <a href={homeHref} class:list={["wordmark text-ink", overlay ? "wordmark-landing" : "text-[1.15rem]"]} aria-label={`${t('site.name')} — home`}>
      {t('site.name')}
    </a>

    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      class:list={[overlay ? 'menu-toggle-plain' : 'label -mr-2 px-2 py-1 text-ink/80 transition-colors hover:text-ink']}
    >
      <span data-label-open>{t('nav.menu')}</span>
      <span data-label-close hidden>{t('nav.close')}</span>
    </button>
  </div>

  <nav id="site-menu" class="site-menu" hidden aria-label="Site">
    <div class="shell grid gap-10 py-10 sm:grid-cols-[1fr_auto] sm:items-end">
      <ul class="flex flex-col gap-3">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={link.current ? 'page' : undefined}
                class:list={['font-display text-3xl leading-none transition-colors sm:text-4xl', link.current ? 'text-ink' : 'text-muted hover:text-ink']}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="flex flex-col gap-3 sm:items-end">
        <ul class="flex gap-5">
          {
            external.map((link) => (
              <li>
                <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer" class="label transition-colors hover:text-ink">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="flex gap-4" aria-label={t('nav.language')}>
          {
            languages.map((l) => (
              <li>
                <a
                  href={l.href}
                  data-lang-btn={l.code}
                  aria-current={l.current ? 'true' : undefined}
                  class:list={['label transition-colors', l.current ? 'text-ink underline underline-offset-4' : 'hover:text-ink']}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const button = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('site-menu')!;
  const labelOpen = button.querySelector<HTMLElement>('[data-label-open]')!;
  const labelClose = button.querySelector<HTMLElement>('[data-label-close]')!;

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    header.dataset.open = String(open);
    button.setAttribute('aria-expanded', String(open));
    labelOpen.hidden = open;
    labelClose.hidden = !open;
  };

  button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  document.addEventListener('click', (e) => {
    if (!header.contains(e.target as Node)) setOpen(false);
  });
  menu.querySelectorAll<HTMLAnchorElement>('[data-lang-btn]').forEach((link) => {
    link.addEventListener('click', () => localStorage.setItem('preferred-lang', link.dataset.langBtn ?? ''));
  });

  const syncScroll = () => {
    header.dataset.scrolled = window.scrollY > 8 ? 'true' : 'false';
  };
  syncScroll();
  window.addEventListener('scroll', syncScroll, { passive: true });
</script>
