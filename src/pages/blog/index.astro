---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import PostFilter from '../../components/react/PostFilter';
import { SITE, TAGS } from '../../consts';
import { getPosts, leadPostId } from '../../lib/posts';

const posts = await getPosts();
const lead = leadPostId(posts);

// Only offer tags that actually have posts, in the canonical order.
const used = new Set(posts.map((post) => post.data.tag));
const tags = TAGS.filter((tag) => used.has(tag));
---

<BaseLayout
  title={`Writing — ${SITE.name}`}
  description="Engineering notes on WebRTC, PyTorch, web performance and systems."
>
  <div class="shell py-20">
    <header class="reveal max-w-[46ch]">
      <p class="label flex items-center gap-3">
        <span class="inline-block h-px w-6 bg-accent"></span>
        Writing
      </p>
      <h1 class="mt-4 text-[clamp(2.5rem,6vw,4.25rem)] leading-[1.02]">Engineering notes</h1>
      <p class="mt-6 text-lg leading-relaxed text-muted">
        {posts.length} posts on realtime media, deep learning, and the performance work underneath
        both.
      </p>
    </header>

    <div class="reveal mt-14" style="--reveal-delay:80ms">
      <PostFilter client:load tags={tags} targetId="post-grid" emptyId="post-empty" />
    </div>

    <div id="post-grid" class="mt-10 grid gap-5 sm:grid-cols-2">
      {posts.map((post, i) => <PostCard post={post} feature={post.id === lead} delay={i * 60} />)}
    </div>

    <p id="post-empty" hidden class="py-20 text-center font-mono text-sm text-faint">
      No posts match that filter.
    </p>
  </div>
</BaseLayout>
