---
interface Props {
  /** Rendered under the figure, after an auto-numbered "Figure N" prefix. */
  caption: string;
  /** How far the figure is allowed to break past the 46rem measure. */
  width?: 'measure' | 'wide' | 'bleed';
}

// Figures fill --measure (58rem) by default, so a chart lines up with the
// paragraph above it instead of bulging past it.
const { caption, width = 'measure' } = Astro.props;

const widthClass = { measure: '', wide: 'figure-wide', bleed: 'figure-bleed' }[width];
---

<figure class={widthClass}>
  <slot />
  <figcaption set:html={caption} />
</figure>
