---
import ThemeToggle from './react/ThemeToggle';
import LanguageSwitch from './LanguageSwitch.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/ui';
import { SITE } from '../consts';

interface Props {
  lang?: Language;
}

const path = Astro.url.pathname;
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homeHref = getLocalizedPath('/', lang);
const navItems = [
  { href: getLocalizedPath('/', lang), label: t('nav.home') },
  { href: getLocalizedPath('/blog/', lang), label: t('nav.writing') },
  { href: getLocalizedPath('/brief/', lang), label: t('nav.briefs') },
];

const isActive = (href: string) => {
  if (href === homeHref) return path === href || path === href.replace(/\/$/, '');
  return path.startsWith(href);
};
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-line/70 bg-bg/90"
>
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a
      href={homeHref}
      class="wordmark text-[1.35rem] text-ink transition-colors hover:text-accent"
      aria-label={`${t('site.name')} — home`}
    >
      {t('site.name')}
    </a>

    <nav class="hidden items-center gap-6 sm:flex" aria-label="Primary">
      {
        navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'font-mono text-[0.72rem] tracking-[0.14em] uppercase transition-colors',
                active
                  ? 'text-ink border-b border-accent pb-0.5'
                  : 'text-muted hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2.5">
      <LanguageSwitch lang={lang} />

      <ThemeToggle client:load />

      <a
        href={SITE.github}
        target="_blank"
        rel="noreferrer"
        class="hidden items-center gap-1.5 font-mono text-[0.72rem] tracking-wider text-muted transition-colors hover:text-ink sm:inline-flex"
      >
        GitHub
      </a>

      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
        class="sketch-control grid size-8 place-items-center text-ink sm:hidden"
      >
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="grid grid-rows-[0fr] overflow-hidden border-t-0 border-line bg-bg/95 transition-[grid-template-rows] duration-300 sm:hidden"
    aria-label="Primary (mobile)"
  >
    <div class="min-h-0 overflow-hidden">
      <div class="shell flex flex-col py-3">
        {
          navItems.map((item) => (
            <a href={item.href} class="border-b border-line/60 py-3 font-display text-base text-ink hover:text-accent transition-colors last:border-b-0">
              {item.label}
            </a>
          ))
        }
        <a href={SITE.github} target="_blank" rel="noreferrer" class="py-3 font-display text-base text-ink hover:text-accent transition-colors">
          GitHub
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const button = document.getElementById('menu-toggle')!;
  const nav = document.getElementById('mobile-nav')!;

  const setOpen = (open: boolean) => {
    nav.classList.toggle('grid-rows-[1fr]', open);
    nav.classList.toggle('grid-rows-[0fr]', !open);
    nav.style.borderTopWidth = open ? '1px' : '0';
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };

  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });
</script>
