---
/**
 * The landing: twenty-one Doré plates, three for each classical planet from
 * Saturn down to the Moon, printed in umber and black by ordered dither (see
 * `lib/descent/`). No title and no sentence of our own — the plates are the
 * page. The furniture is a row of planetary sigils with a tick for each of
 * a planet's plates, and a legend that can be laid into the picture.
 *
 * Every sigil and tick is a real button, named for its planet and plate, so
 * the descent can be walked with a keyboard or a screen reader; the canvas
 * itself is decoration and says so. All the legends are rendered here, so
 * the words are in the page whether or not anyone opens them.
 */
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/ui';
import { LEGENDS } from '../lib/descent/legends';
import { PLANETS, PLATES, ROMAN, WEEKDAY, type Planet } from '../lib/descent/plates';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/** The old signs, drawn on a 24-unit square as 1.5-unit strokes. */
const SIGILS: Record<Planet, string> = {
  saturn: 'M8 3v15.5 M5 5.5h6 M8 12.5c1.5-2.6 7.5-3 7.5 1.2c0 2.6-3.2 3.6-3.2 5.8c0 1.1.9 1.7 2.2 1.7',
  jupiter: 'M5.5 8.5c0-3 3.8-4.6 5.9-2.6c2.3 2.2-.6 6.3-5.4 10.1h13 M15.5 5v15',
  mars: 'M14 10a5.5 5.5 0 1 0 .01 .01z M14 10l5-5 M14.5 5h4.5v4.5',
  sun: 'M12 4.5a7.5 7.5 0 1 0 .01 0z M12 11.2a.8 .8 0 1 0 .01 0z',
  venus: 'M12 3.5a5 5 0 1 0 .01 0z M12 13.5v7.5 M8.5 17.5h7',
  mercury: 'M8.5 3c.4 2 1.8 3 3.5 3s3.1-1 3.5-3 M12 7a4 4 0 1 0 .01 0z M12 15v6.5 M9 18.5h6',
  moon: 'M15.5 4.2a8 8 0 1 0 0 15.6a6.6 6.6 0 0 1 0-15.6z',
};
/** An open book, for the legend. */
const BOOK = 'M3 6.5c3-1.6 6-1.4 9 .6v12.4c-3-2-6-2.2-9-.6z M21 6.5c-3-1.6-6-1.4-9 .6v12.4c3-2 6-2.2 9-.6z';

const name = (planet: Planet) => t(`planet.${planet}`);
const ids = PLATES.map((p) => p.id);
---

<section class="descent" aria-label={t('descent.levels')}>
  {/* The plate to light first depends on the address and the day, which a
      static page can't know; ask for it before the module script runs. */}
  <script is:inline define:vars={{ ids, week: WEEKDAY }}>
    var h = location.hash.slice(1);
    var id = ids.indexOf(h) >= 0 ? h : week[new Date().getDay()];
    var link = document.createElement('link');
    link.rel = 'preload';
    link.as = 'image';
    link.href = '/plates/' + id + '.jpg';
    document.head.appendChild(link);
  </script>
  <canvas class="descent-canvas" aria-hidden="true"></canvas>

  <aside class="descent-legend" aria-label={t('descent.legend')} aria-live="off" hidden>
    {
      PLATES.map((plate) => {
        const legend = LEGENDS[plate.id];
        return (
          <article data-plate={plate.id} hidden>
            <p class="descent-legend-kicker" data-line>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={SIGILS[plate.planet]} />
              </svg>
              <span>
                {name(plate.planet)} · {ROMAN[plate.n - 1]}
              </span>
            </p>
            <blockquote class="descent-legend-verse">
              {legend.verse.map((line) => (
                <span data-line>{line}</span>
              ))}
            </blockquote>
            <p class="descent-legend-source" data-line>
              {legend.source}
            </p>
            <p class="descent-legend-note" data-line lang={lang}>
              {legend.note[lang]}
            </p>
            <p class="descent-legend-credit" data-line>
              {plate.credit}
            </p>
          </article>
        );
      })
    }
  </aside>

  <nav class="descent-bar" aria-label={t('descent.levels')}>
    <ol class="descent-chapters">
      {
        PLANETS.map((planet, k) => (
          <li class="descent-chapter" style={`--i: ${Math.abs(k - 3)}`}>
            <button type="button" class="descent-sigil" data-planet={planet} aria-pressed="false" aria-label={name(planet)} title={name(planet)}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={SIGILS[planet]} />
              </svg>
            </button>
            <span class="descent-ticks">
              {PLATES.filter((p) => p.planet === planet).map((p) => (
                <button
                  type="button"
                  class="descent-tick"
                  data-plate={p.id}
                  data-planet={planet}
                  aria-pressed="false"
                  aria-label={`${name(planet)} ${ROMAN[p.n - 1]} — ${p.credit}`}
                  tabindex="-1"
                />
              ))}
            </span>
          </li>
        ))
      }
    </ol>
    <button type="button" class="descent-legend-toggle" data-legend-toggle aria-pressed="false" aria-label={t('descent.legend')} title={`${t('descent.legend')} (L)`}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d={BOOK} />
      </svg>
    </button>
  </nav>
</section>

<script>
  import { initDescent } from '../lib/descent/scene';

  const root = document.querySelector<HTMLElement>('.descent');
  if (root) initDescent(root);
</script>
