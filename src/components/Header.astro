---
/**
 * The header is a wordmark and one word, "Menu". Everything a visitor might
 * want — writing, briefs, GitHub, RSS, the language — waits behind that word
 * so the pages, and above all the landing plates, are not crowded by chrome.
 * Opening it prints a panel under the bar — in the same ordered dither the
 * landing's plates and its bar of sigils come and go by — and it never takes
 * over the viewport.
 */
import { getLangFromUrl, getLocalizedPath, listLanguages, useTranslations } from '../i18n/utils';
import { LANGUAGES, type Language } from '../i18n/ui';
import { SITE } from '../consts';
import { ROMAN } from '../lib/descent/plates';

interface Props {
  lang?: Language;
  /** On the landing page the header floats over the plates, nameless. */
  overlay?: boolean;
}

const path = Astro.url.pathname;
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const overlay = Astro.props.overlay ?? false;
const t = useTranslations(lang);

const homeHref = getLocalizedPath('/', lang);
const links = [
  { href: getLocalizedPath('/blog/', lang), label: t('nav.writing'), current: path.startsWith(getLocalizedPath('/blog/', lang)) },
  { href: getLocalizedPath('/brief/', lang), label: t('nav.briefs'), current: path.startsWith(getLocalizedPath('/brief/', lang)) },
];
const external = [
  { href: SITE.github, label: t('nav.github') },
  { href: '/rss.xml', label: t('footer.rss') },
];
const languages = listLanguages().map((code) => ({
  code,
  label: LANGUAGES[code],
  href: getLocalizedPath(path, code),
  current: code === lang,
}));
---

<header id="site-header" class="site-header" data-overlay={overlay ? 'true' : 'false'} data-scrolled="false" data-open="false">
  <div class="shell site-bar">
    {
      !overlay && (
        <a href={homeHref} class="wordmark" aria-label={`${t('site.name')} — home`}>
          {t('site.name')}
        </a>
      )
    }

    <button id="menu-toggle" class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
      <span data-label-open>{t('nav.menu')}</span>
      <span data-label-close hidden>{t('nav.close')}</span>
    </button>
  </div>

  <nav id="site-menu" class="site-menu" hidden aria-label="Site">
    <div class="shell site-menu-grid">
      <ol class="site-menu-links">
        {
          links.map((link, i) => (
            <li>
              <a href={link.href} aria-current={link.current ? 'page' : undefined} class="site-menu-link">
                <span class="site-menu-num" aria-hidden="true">
                  {ROMAN[i]}
                </span>
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <div class="site-menu-aside">
        <ul class="site-menu-row">
          {
            external.map((link) => (
              <li>
                <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel="noreferrer">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <ul class="site-menu-row" aria-label={t('nav.language')}>
          {
            languages.map((l) => (
              <li>
                <a href={l.href} data-lang-btn={l.code} aria-current={l.current ? 'true' : undefined}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </nav>
</header>

<script>
  import { createMasks } from '../lib/descent/chrome';

  const header = document.getElementById('site-header')!;
  const button = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('site-menu')!;
  const labelOpen = button.querySelector<HTMLElement>('[data-label-open]')!;
  const labelClose = button.querySelector<HTMLElement>('[data-label-close]')!;

  /** The size of one dither cell, in CSS px; the plates use about the same. */
  const CELL = 3;
  const masks = createMasks(window.matchMedia('(prefers-reduced-motion: reduce)').matches);
  let dpr = 0;

  const setOpen = (open: boolean) => {
    if (open === (header.dataset.open === 'true')) return;
    header.dataset.open = String(open);
    button.setAttribute('aria-expanded', String(open));
    labelOpen.hidden = open;
    labelClose.hidden = !open;
    if (open) {
      if (dpr !== window.devicePixelRatio) {
        dpr = window.devicePixelRatio || 1;
        masks.resize(CELL, Math.max(1, Math.round(CELL * dpr)));
      }
      menu.hidden = false;
      void masks.run([menu], 'in', 240);
    } else {
      // Reopened before it is gone, the later run takes the menu over and
      // this one never finishes, so it never hides what is now open.
      void masks.run([menu], 'out', 180).then(() => {
        if (header.dataset.open !== 'true') menu.hidden = true;
      });
    }
  };

  button.addEventListener('click', () => setOpen(header.dataset.open !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  document.addEventListener('click', (e) => {
    if (!header.contains(e.target as Node)) setOpen(false);
  });
  menu.querySelectorAll<HTMLAnchorElement>('[data-lang-btn]').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem('preferred-lang', link.dataset.langBtn ?? '');
      } catch {
        // Storage can be off; the link still goes where it says.
      }
    });
  });

  const syncScroll = () => {
    header.dataset.scrolled = window.scrollY > 8 ? 'true' : 'false';
  };
  syncScroll();
  window.addEventListener('scroll', syncScroll, { passive: true });
</script>
