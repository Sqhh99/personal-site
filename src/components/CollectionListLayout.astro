---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Language } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getColumn, getColumnBasePath, listColumns, type ColumnId } from '../lib/columns';
import { ROMAN } from '../lib/descent/plates';
import { getPagedListUrl } from '../lib/pagination';
import Pager from './Pager.astro';

interface Props {
  column: ColumnId;
  lang: Language;
  currentPage: number;
  totalPages: number;
  totalItems: number;
  gridId?: string;
  emptyId?: string;
  pagerId?: string;
  clientPagerId?: string;
}

const {
  column,
  lang,
  currentPage,
  totalPages,
  totalItems,
  gridId,
  emptyId,
  pagerId,
  clientPagerId,
} = Astro.props;
const config = getColumn(column);
const t = useTranslations(lang);
const basePath = getColumnBasePath(column, lang);
const prevUrl = currentPage > 1 ? getPagedListUrl(basePath, currentPage - 1) : undefined;
const nextUrl = currentPage < totalPages ? getPagedListUrl(basePath, currentPage + 1) : undefined;
---

<BaseLayout
  lang={lang}
  title={t(config.i18n.title)}
  description={t(config.i18n.description)}
>
  <div class="shell collection">
    <header class="collection-head reveal">
      {/* The column's number in the menu, not its name again over its name. */}
      <p class="label flex items-center gap-3" aria-hidden="true">
        <span class="ink-rule"></span>
        {ROMAN[listColumns().findIndex((c) => c.id === column)]}
      </p>
      <div class="collection-title">
        <h1>{t(config.i18n.heading)}</h1>
        <p>
          <span class="collection-count">{totalItems}</span> {t(config.i18n.description)}
        </p>
      </div>
    </header>

    {Astro.slots.has('toolbar') && (
      <div class="collection-toolbar reveal" style="--reveal-delay:80ms">
        <slot name="toolbar" />
      </div>
    )}

    <div id={gridId} class="entry-list">
      <slot name="grid" />
    </div>

    <div id={emptyId} hidden={totalItems > 0} class="py-24 text-center">
      <p class="font-mono text-sm text-faint">{t(config.i18n.empty)}</p>
    </div>

    {/* One page needs no pager. */}
    {totalPages > 1 && <Pager
      id={pagerId}
      currentPage={currentPage}
      totalPages={totalPages}
      prevUrl={prevUrl}
      nextUrl={nextUrl}
      lang={lang}
      ariaLabel={t(config.i18n.paginationLabel)}
    />}
    {clientPagerId && <div id={clientPagerId}></div>}
  </div>
</BaseLayout>
