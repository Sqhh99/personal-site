---
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/ui';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const focusAreas = t('focus.areas');
---

<div
  class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 xl:grid-cols-4 shadow-xs"
>
  {
    focusAreas.map((area, i) => (
      <article
        class="reveal group relative flex min-h-[19.5rem] flex-col bg-surface p-8 transition-all duration-300 hover:bg-sunk/50 hover:shadow-xs"
        style={`--reveal-delay:${i * 80}ms`}
      >
        <div class="absolute inset-x-0 top-0 h-0.5 bg-accent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
        <div class="flex items-center justify-between">
          <span class="font-mono text-[0.7rem] font-medium tracking-[0.2em] text-accent">{area.index}</span>
          <span class="size-1.5 rounded-full bg-line-strong transition-colors group-hover:bg-accent"></span>
        </div>
        <h3 class="mt-8 text-2xl font-normal leading-tight text-ink group-hover:text-accent transition-colors">{area.title}</h3>
        <p class="mt-3 text-[0.925rem] leading-relaxed text-muted">{area.description}</p>
        <ul class="mt-auto pt-6 flex flex-wrap gap-1.5" aria-label={`Tags for ${area.title}`}>
          {area.tags.map((tag) => (
            <li class="rounded-full border border-line/80 bg-surface-sunk/40 px-2.5 py-1 font-mono text-[0.625rem] tracking-wider text-faint group-hover:border-line-strong group-hover:text-muted transition-colors">
              {tag}
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
