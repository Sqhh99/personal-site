---
import Entry from './Entry.astro';
import type { Post } from '../lib/posts';
import { getPostUrl, readingTime } from '../lib/posts';
import type { Language } from '../i18n/ui';

interface Props {
  post: Post;
  delay?: number;
  lang?: Language;
  hidden?: boolean;
}

const { post, delay = 0, lang = 'en', hidden = false } = Astro.props;
const { title, description, tag, date } = post.data;
// Articles are single-language, so flag the ones not written in the UI's language.
const foreign = post.data.lang !== lang ? post.data.lang.toUpperCase() : undefined;
// Lower-cased haystack read by the PostFilter island.
const search = `${title} ${description} ${tag}`.toLowerCase();
---

<Entry
  href={getPostUrl(post, lang)}
  title={title}
  description={description}
  date={date}
  lang={lang}
  readingLabel={readingTime(post.body, lang)}
  tag={tag}
  foreign={foreign}
  delay={delay}
  hidden={hidden}
  data-post
  data-tag={tag}
  data-search={search}
/>
