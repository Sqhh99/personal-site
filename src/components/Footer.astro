---
import { SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div
    class="shell flex flex-col gap-4 py-8 font-mono text-[0.7rem] tracking-wide text-faint sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {SITE.name} · Built with Astro, deployed on Cloudflare</p>
    <div class="flex items-center gap-5">
      <a href="/rss.xml" class="transition-colors hover:text-ink">RSS</a>
      <a href={SITE.repository} target="_blank" rel="noreferrer" class="transition-colors hover:text-ink">
        Source
      </a>
      <a href="#main" class="transition-colors hover:text-ink">Back to top ↑</a>
    </div>
  </div>
</footer>
