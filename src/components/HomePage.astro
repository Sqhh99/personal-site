---
/**
 * The landing page is the poster and nothing else. The writing and the briefs
 * are one click away in its index; nothing waits below the fold.
 */
import PosterHero from './PosterHero.astro';
import type { Language } from '../i18n/ui';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<PosterHero lang={lang} />
