---
/**
 * Landing engraving: the picture is the page. Chrome is copperplate marginalia —
 * wordmark and menu live in the header; the tagline sits in the void; scroll
 * is a vertical cue at the lower right. No UI-kit plates.
 */
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/ui';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="ink-hero" aria-label={t('hero.line')}>
  <canvas id="ink-scene" class="ink-hero-canvas" aria-hidden="true"></canvas>
  <div class="ink-hero-grain" aria-hidden="true"></div>

  <p class="ink-hero-line font-display">{t('hero.line')}</p>

  <a href="#latest" class="ink-hero-scroll" aria-label={t('hero.scroll')}>
    <span class="ink-hero-scroll-rule" aria-hidden="true"></span>
    <span class="ink-hero-scroll-label">{t('hero.scroll')}</span>
  </a>
</section>

<script>
  import { initInkScene } from '../lib/ink-scene';

  const canvas = document.getElementById('ink-scene');
  if (canvas instanceof HTMLCanvasElement) initInkScene(canvas);
</script>
