---
interface Props {
  index: string;
  title: string;
  lede?: string;
  id?: string;
  /** 1 where this is the page's only heading, so a page is never without an h1. */
  level?: 1 | 2;
}

const { index, title, lede, id, level = 2 } = Astro.props;
const Title = level === 1 ? 'h1' : 'h2';
---

<div
  id={id}
  class="reveal flex flex-col justify-between gap-6 pb-12 md:flex-row md:items-end md:gap-16"
>
  <div>
    <p class="label flex items-center gap-3">
      <span class="ink-rule"></span>
      {index}
    </p>
    <Title class="mt-4 text-4xl leading-[1.05] tracking-tight md:text-5xl text-ink font-display">
      {title}
    </Title>
  </div>
  {lede && <p class="max-w-[44ch] text-[0.975rem] leading-relaxed text-muted">{lede}</p>}
</div>
