---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
---

<BaseLayout title={`Not found — ${SITE.name}`} description="That page doesn't exist.">
  <div class="shell flex min-h-[65svh] flex-col justify-center py-24">
    <p class="label flex items-center gap-3">
      <span class="inline-block h-px w-6 bg-accent"></span>
      Error 404
    </p>
    <h1 class="mt-4 max-w-[16ch] text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.03] font-display text-ink">
      That page isn't here.
    </h1>
    <p class="mt-6 max-w-[46ch] text-lg leading-relaxed text-muted">
      The link may be out of date, or the post may have been renamed. The writing index is
      probably what you want.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-5">
      <a
        href="/blog"
        class="inline-flex h-12 items-center gap-2 rounded-xl bg-accent px-6 text-[0.95rem] font-medium text-surface shadow-xs transition-all hover:bg-accent-deep hover:shadow-md"
      >
        Browse the writing →
      </a>
      <a
        href="/"
        class="border-b border-line-strong pb-1 text-[0.95rem] text-muted transition-colors hover:border-ink hover:text-ink"
      >
        Back home
      </a>
    </div>
  </div>
</BaseLayout>
