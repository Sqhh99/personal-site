---
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/ui';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section class="shell pt-14 pb-12 sm:pt-18 sm:pb-14 border-b border-line/60">
  <div class="max-w-[48ch]">
    <h1 class="font-display text-4xl sm:text-5xl font-normal tracking-tight text-ink">
      {t('site.name')}
    </h1>
    <p class="mt-4 text-lg sm:text-xl leading-relaxed text-muted font-sans">
      {t('hero.lead')}
    </p>
  </div>
</section>
