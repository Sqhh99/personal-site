---
import Entry from './Entry.astro';
import type { Language } from '../i18n/ui';
import { getBriefUrl, type Brief } from '../lib/briefs';
import { readingTime } from '../lib/posts';

interface Props {
  brief: Brief;
  lang?: Language;
  delay?: number;
}

const { brief, lang = 'en', delay = 0 } = Astro.props;
---

{/* Every brief has the same source, so its row carries no tag. */}
<Entry
  href={getBriefUrl(brief, lang)}
  title={brief.data.title}
  description={brief.data.description}
  date={brief.data.date}
  lang={lang}
  readingLabel={readingTime(brief.body, lang)}
  delay={delay}
/>
