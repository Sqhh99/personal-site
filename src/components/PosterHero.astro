---
/**
 * The landing: a poster. Doré's Paradiso XXXI, printed as characters on a dark
 * sheet (see `lib/poster/scene.ts`), with the name set large behind it and the
 * furniture of a printed sheet — rules, registration marks, a plate number, a
 * barcode — round the edge. No sentence; the picture is the point.
 *
 * Everything but the picture is real text, so it stays selectable and read
 * aloud; the canvas is decoration and says so.
 */
import { getLocalizedPath, useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/ui';
import { SITE } from '../consts';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const index = [
  { n: '01', href: getLocalizedPath('/blog/', lang), label: t('nav.writing') },
  { n: '02', href: getLocalizedPath('/brief/', lang), label: t('nav.briefs') },
];

// A barcode spelled from the domain, so it is decoration that still means something.
const code = 'sqhh99.dev';
const bars: Array<{ x: number; w: number }> = [];
let x = 0;
for (const ch of code) {
  const c = ch.charCodeAt(0);
  for (let b = 0; b < 4; b += 1) {
    const w = 1 + ((c >> (b * 2)) & 1) + ((c >> (b * 2 + 1)) & 1);
    if (b % 2 === 0) bars.push({ x, w });
    x += w;
  }
  x += 1;
}
const barWidth = x;
---

<section class="poster">
  <h1 class="poster-title">{SITE.name}</h1>

  <canvas class="poster-canvas" aria-hidden="true" data-src="/art/paradiso-31.webp"></canvas>

  <div class="poster-chrome">
    <div class="poster-top label-row" aria-hidden="true">
      <span class="poster-rule"></span>
      <span>星図 / FIG. 31</span>
      <span class="poster-rule"></span>
      <span>©{year}</span>
    </div>

    <p class="poster-fig" aria-hidden="true">FIG. 31</p>

    <div class="poster-info">
      <nav class="poster-cell" aria-label={t('hero.index')}>
        <span class="poster-label">{t('hero.index')}</span>
        <ul class="poster-index">
          {
            index.map((item) => (
              <li>
                <a href={item.href}>
                  <span class="poster-n">{item.n}</span>
                  {item.label}
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="poster-cell poster-cell--wide">
        <span class="poster-label">{t('hero.plate')}</span>
        <p>Gustave Doré — <i>Paradiso</i>, Canto XXXI, 1868</p>
      </div>

      <div class="poster-cell poster-cell--wide">
        <span class="poster-label">{t('hero.sphere')}</span>
        <p>X · Empyrean · 至高天</p>
      </div>

      <div class="poster-cell poster-cell--code" aria-hidden="true">
        <svg class="poster-barcode" viewBox={`0 0 ${barWidth} 24`} preserveAspectRatio="none">
          {bars.map((b) => <rect x={b.x} y="0" width={b.w} height="24" />)}
        </svg>
        <span class="poster-label">{code}</span>
      </div>
    </div>

    <span class="poster-reg poster-reg--tl" aria-hidden="true"></span>
    <span class="poster-reg poster-reg--tr" aria-hidden="true"></span>
    <span class="poster-reg poster-reg--bl" aria-hidden="true"></span>
    <span class="poster-reg poster-reg--br" aria-hidden="true"></span>
  </div>
</section>

<script>
  import { initPoster } from '../lib/poster/scene';

  const canvas = document.querySelector<HTMLCanvasElement>('.poster-canvas');
  if (canvas) initPoster(canvas);
</script>
