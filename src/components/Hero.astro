---
import WaveField from './react/WaveField';
import { SITE } from '../consts';

const chips = ['WebRTC', 'PyTorch', 'TypeScript', 'Systems'];
---

<section class="relative isolate overflow-hidden">
  <div class="hero-backdrop pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    {/* Static wash: visible immediately, and whole visual if WebGL or three.js chunk never arrives */}
    <div class="hero-wash absolute inset-0 opacity-80"></div>
    <div class="hero-field absolute inset-0 opacity-90">
      <WaveField client:visible />
    </div>
  </div>

  <div class="shell relative flex min-h-[min(48rem,90svh)] flex-col justify-center py-20 lg:py-24">
    <p
      class="reveal inline-flex w-fit items-center gap-2.5 rounded-full border border-line/80 bg-surface/90 px-4 py-1.5 font-mono text-[0.68rem] tracking-[0.14em] text-muted uppercase shadow-xs backdrop-blur-md transition-all hover:border-accent/40"
    >
      <span class="relative flex size-2">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-75"></span>
        <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
      </span>
      {SITE.role}
    </p>

    <h1
      class="reveal mt-8 max-w-[20ch] text-[clamp(2.75rem,7vw,5.25rem)] leading-[0.98] tracking-tight font-display"
      style="--reveal-delay:80ms"
    >
      Notes on <em class="not-italic text-accent font-serif underline decoration-accent/30 underline-offset-8">realtime media</em>, deep learning, and the parts of the
      web that resist abstraction.
    </h1>

    <p
      class="reveal mt-8 max-w-[54ch] text-lg leading-relaxed text-muted font-sans"
      style="--reveal-delay:160ms"
    >
      I'm {SITE.name}, a software engineer working on WebRTC pipelines, PyTorch training and
      inference, and the performance work that sits underneath both. This is where I write the
      details down.
    </p>

    <div class="reveal mt-10 flex flex-wrap items-center gap-5" style="--reveal-delay:240ms">
      <a
        href="/blog"
        class="group inline-flex h-12 items-center gap-3 rounded-xl bg-accent px-6 text-[0.95rem] font-medium text-surface shadow-xs transition-all duration-300 hover:-translate-y-0.5 hover:bg-accent-deep hover:shadow-md active:translate-y-0"
      >
        Read the writing
        <svg
          viewBox="0 0 24 24"
          class="size-4 transition-transform duration-300 group-hover:translate-x-1.5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
      <a
        href="#focus"
        class="group inline-flex items-center gap-1.5 border-b border-line-strong/80 pb-1 text-[0.95rem] text-muted transition-colors hover:border-accent hover:text-ink"
      >
        What I work on
        <span class="transition-transform duration-300 group-hover:translate-y-0.5" aria-hidden="true">↓</span>
      </a>
    </div>

    <ul class="reveal mt-14 flex flex-wrap gap-2.5" style="--reveal-delay:320ms" aria-label="Topics">
      {
        chips.map((chip) => (
          <li class="rounded-full border border-line/80 bg-surface/80 px-3.5 py-1.5 font-mono text-[0.68rem] tracking-wider text-muted backdrop-blur-md shadow-2xs transition-all hover:border-line-strong hover:text-ink hover:scale-105">
            <span class="text-accent/80 mr-1.5">#</span>{chip}
          </li>
        ))
      }
    </ul>
  </div>
</section>
