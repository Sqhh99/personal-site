---
/**
 * The landing page is the descent and nothing else: twenty-one plates, and
 * only the words they illustrate, for whoever opens the legend.
 * The writing and the briefs wait behind the header's menu.
 */
import DescentHero from './DescentHero.astro';
import type { Language } from '../i18n/ui';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
---

<DescentHero lang={lang} />
