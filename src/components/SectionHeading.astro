---
interface Props {
  index: string;
  title: string;
  lede?: string;
  id?: string;
}

const { index, title, lede, id } = Astro.props;
---

<div
  id={id}
  class="reveal flex flex-col justify-between gap-6 pb-12 md:flex-row md:items-end md:gap-16"
>
  <div>
    <p class="label flex items-center gap-3">
      <span class="inline-block h-px w-6 bg-accent"></span>
      {index}
    </p>
    <h2 class="mt-4 text-4xl leading-[1.05] md:text-5xl">{title}</h2>
  </div>
  {lede && <p class="max-w-[42ch] text-[0.95rem] leading-relaxed text-muted">{lede}</p>}
</div>
