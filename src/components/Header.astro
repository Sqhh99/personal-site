---
import ThemeToggle from './react/ThemeToggle';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/ui';
import { SITE } from '../consts';

interface Props {
  lang?: Language;
}

const path = Astro.url.pathname;
const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homeHref = lang === 'zh' ? '/zh/' : '/';
const navItems = [
  { href: lang === 'zh' ? '/zh/' : '/', label: t('nav.home') },
  { href: lang === 'zh' ? '/zh/blog/' : '/blog/', label: t('nav.writing') },
  { href: '/brief/', label: t('nav.briefs') },
];

const isActive = (href: string) => {
  if (href === '/' || href === '/zh/') return path === href;
  return path.startsWith(href);
};

const enPath = getLocalizedPath(path, 'en');
const zhPath = getLocalizedPath(path, 'zh');
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-line/60 bg-bg/85 backdrop-blur-md transition-all duration-300"
>
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a href={homeHref} class="group flex items-center gap-2 font-display text-xl font-medium tracking-tight text-ink hover:text-accent transition-colors" aria-label={`${t('site.name')} — home`}>
      <span>{t('site.name')}</span>
    </a>

    <nav class="hidden items-center gap-1 sm:flex" aria-label="Primary">
      {
        navItems.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'rounded-lg px-3 py-1.5 text-sm font-medium transition-colors',
                active
                  ? 'text-ink font-semibold bg-surface-sunk/60'
                  : 'text-muted hover:text-ink hover:bg-surface-sunk/30',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-3">
      <!-- Language Switcher -->
      <div class="flex items-center rounded-lg border border-line bg-surface/80 p-0.5 font-mono text-[0.725rem]">
        <a
          href={enPath}
          data-lang-btn="en"
          class:list={[
            'rounded-md px-2 py-0.5 transition-colors',
            lang === 'en'
              ? 'bg-accent text-surface font-medium'
              : 'text-muted hover:text-ink',
          ]}
        >
          EN
        </a>
        <a
          href={zhPath}
          data-lang-btn="zh"
          class:list={[
            'rounded-md px-2 py-0.5 transition-colors',
            lang === 'zh'
              ? 'bg-accent text-surface font-medium'
              : 'text-muted hover:text-ink',
          ]}
        >
          中文
        </a>
      </div>

      <ThemeToggle client:load />

      <a
        href={SITE.github}
        target="_blank"
        rel="noreferrer"
        class="hidden items-center gap-1.5 text-sm font-medium text-muted transition-colors hover:text-ink sm:inline-flex"
      >
        <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true">
          <path
            d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.35 1.08 2.92.83.09-.64.35-1.08.64-1.33-2.22-.25-4.55-1.1-4.55-4.93 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.84a9.6 9.6 0 0 1 2.5.34c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86V21c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
          ></path>
        </svg>
        GitHub
      </a>

      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
        class="grid size-8 place-items-center rounded-lg border border-line bg-surface text-ink transition-colors sm:hidden"
      >
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <path d="M4 8h16M4 16h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="grid grid-rows-[0fr] overflow-hidden border-t-0 border-line bg-bg/95 backdrop-blur-xl transition-[grid-template-rows] duration-300 sm:hidden"
    aria-label="Primary (mobile)"
  >
    <div class="min-h-0 overflow-hidden">
      <div class="shell flex flex-col py-3">
        {
          navItems.map((item) => (
            <a href={item.href} class="border-b border-line/60 py-3 font-display text-base text-ink hover:text-accent transition-colors last:border-b-0">
              {item.label}
            </a>
          ))
        }
        <a href={SITE.github} target="_blank" rel="noreferrer" class="py-3 font-display text-base text-ink hover:text-accent transition-colors">
          GitHub
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  // Save preferred language when clicking language switcher links
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetLang = btn.getAttribute('data-lang-btn');
      if (targetLang) {
        localStorage.setItem('preferred-lang', targetLang);
      }
    });
  });

  const button = document.getElementById('menu-toggle')!;
  const nav = document.getElementById('mobile-nav')!;

  const setOpen = (open: boolean) => {
    nav.classList.toggle('grid-rows-[1fr]', open);
    nav.classList.toggle('grid-rows-[0fr]', !open);
    nav.style.borderTopWidth = open ? '1px' : '0';
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };

  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });
</script>
