---
import CollectionListLayout from './CollectionListLayout.astro';
import PostCard from './PostCard.astro';
import PostFilter from './react/PostFilter';
import { TAGS } from '../consts';
import { getColumn } from '../lib/columns';
import { paginate } from '../lib/pagination';
import { getPosts, leadPostId } from '../lib/posts';
import { useTranslations } from '../i18n/utils';
import type { Language } from '../i18n/ui';

interface Props {
  lang: Language;
  currentPage?: number;
}

const { lang, currentPage = 1 } = Astro.props;
const t = useTranslations(lang);

const posts = await getPosts(lang);
const config = getColumn('blog');
const page = paginate(posts, currentPage, config.pageSize);
const pagePostIds = new Set(page.items.map((post) => post.id));
const lead = leadPostId(posts);

// Only offer tags that actually have posts, in canonical order.
const used = new Set(posts.map((post) => post.data.tag));
const tags = TAGS.filter((tag) => used.has(tag));

const filterLabels = {
  searchPlaceholder: t('blog.searchPlaceholder'),
  filterAll: t('blog.filterAll'),
  showing: t('blog.showing'),
  postSingular: t('blog.postSingular'),
  postPlural: t('blog.postPlural'),
  emptyText: t('blog.empty'),
  previousPage: t('pager.prev'),
  nextPage: t('pager.next'),
  pageStatus: t('pager.status'),
  pagination: t(config.i18n.paginationLabel),
  searchAria: t('blog.searchAria'),
  clearSearch: t('blog.clearSearch'),
  filterByTag: t('blog.filterByTag'),
};
---

<CollectionListLayout
  column="blog"
  lang={lang}
  currentPage={page.page}
  totalPages={page.totalPages}
  totalItems={page.totalItems}
  gridId="post-grid"
  emptyId="post-empty"
  pagerId="blog-pager"
  clientPagerId="filter-pager"
>
  <Fragment slot="toolbar">
    <PostFilter
      client:load
      tags={tags}
      targetId="post-grid"
      emptyId="post-empty"
      ssrPagerId="blog-pager"
      clientPagerId="filter-pager"
      pageSize={config.pageSize}
      currentPage={page.page}
      labels={filterLabels}
    />
  </Fragment>

  <Fragment slot="grid">
    <!--
      PostFilter searches across the whole collection, including from paged URLs.
      Blog therefore keeps all cards in the DOM and reveals only the SSR page
      initially; unfiltered columns render only page.items.
    -->
    {posts.map((post, i) => (
      <PostCard
        post={post}
        feature={post.id === lead}
        delay={(i % config.pageSize) * 60}
        lang={lang}
        hidden={!pagePostIds.has(post.id)}
      />
    ))}
  </Fragment>
</CollectionListLayout>
