---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Atmosphere from '../components/Atmosphere.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, getLocalizedPath, listLanguages, useTranslations } from '../i18n/utils';
import { HTML_LANG, type Language } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  /** Overrides the og:type, e.g. "article" on a post page. */
  ogType?: 'website' | 'article';
  publishedAt?: Date;
  lang?: Language;
}

const urlLang = getLangFromUrl(Astro.url);
const {
  lang = urlLang,
  ogType = 'website',
  publishedAt,
} = Astro.props;

const t = useTranslations(lang);
const title = Astro.props.title ?? t('site.title');
const description = Astro.props.description ?? t('site.description');

const canonical = new URL(Astro.url.pathname, Astro.site);
const htmlLang = HTML_LANG[lang];
const alternates = listLanguages().map((code) => ({
  lang: HTML_LANG[code],
  href: new URL(getLocalizedPath(Astro.url.pathname, code), Astro.site).href,
}));
---

<!doctype html>
<html lang={htmlLang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={t('site.name')} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(getLocalizedPath(Astro.url.pathname, 'en'), Astro.site).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={t('site.name')} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#f3eee3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161310" media="(prefers-color-scheme: dark)" />

    <!-- Resolve the theme before first paint so the ivory palette never flashes
         in front of someone who chose dark. -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const preferred = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = stored ?? preferred;
      })();
    </script>
  </head>

  <body class="min-h-screen bg-bg text-ink antialiased">
    <Atmosphere />
    <div class="paper-grain" aria-hidden="true"></div>
    <div class="page-frame" aria-hidden="true"></div>

    <div class="site-stack">
      <a
        href="#main"
        class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:border focus:border-line focus:bg-surface focus:px-4 focus:py-2 focus:text-sm"
      >
        {t('a11y.skip')}
      </a>

      <Header lang={lang} />

      <main id="main">
        <slot />
      </main>

      <Footer lang={lang} />
    </div>

    <script>
      // Scroll reveal. Elements opt in with `class="reveal"`. First paint stays
      // visible; we only hide below-the-fold items after this script runs.
      const targets = document.querySelectorAll<HTMLElement>('.reveal');

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const inView = (el: HTMLElement) => el.getBoundingClientRect().top < window.innerHeight * 0.92;
        targets.forEach((el) => {
          if (inView(el)) el.classList.add('is-visible');
        });
        document.documentElement.setAttribute('data-reveal', '');

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
        );
        targets.forEach((el) => {
          if (!el.classList.contains('is-visible')) observer.observe(el);
        });
      } else {
        targets.forEach((el) => el.classList.add('is-visible'));
      }
    </script>

    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </body>
</html>
