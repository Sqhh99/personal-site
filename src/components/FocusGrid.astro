---
import { FOCUS_AREAS } from '../consts';
---

{/* `gap-px` over a line-coloured background draws the dividers, so the grid
    stays correct at every column count without per-child border variants. */}
<div
  class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 xl:grid-cols-4"
>
  {
    FOCUS_AREAS.map((area, i) => (
      <article
        class="reveal flex min-h-[19rem] flex-col bg-surface p-7 transition-colors duration-300 hover:bg-sunk"
        style={`--reveal-delay:${i * 80}ms`}
      >
        <span class="font-mono text-[0.7rem] tracking-[0.18em] text-accent">{area.index}</span>
        <h3 class="mt-auto text-2xl">{area.title}</h3>
        <p class="mt-3 text-[0.9rem] leading-relaxed text-muted">{area.description}</p>
        <ul class="mt-6 flex flex-wrap gap-1.5">
          {area.tags.map((tag) => (
            <li class="rounded-full border border-line px-2.5 py-1 font-mono text-[0.6rem] tracking-wider text-faint">
              {tag}
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
